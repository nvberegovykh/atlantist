<%# Default landing layout. Replace with your own design. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= slug ? slug + ' — Coming soon' : 'Coming soon' %></title>
  <%- themeCSS %>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh; margin: 0;
      background: #fafafa; color: #1a1a1a;
    }
    .placeholder { text-align: center; padding: 40px; max-width: 480px; }
    .placeholder h1 { font-size: 2rem; margin: 0 0 0.5rem; font-weight: 600; }
    .placeholder p { color: #6a6a6a; margin: 0; line-height: 1.5; }
  </style>
</head>
<body>
  <div class="placeholder">
    <h1>Coming soon</h1>
    <p>This site is being prepared. Refresh in a moment.</p>
  </div>
  <%- analyticsSnippet %>
</body>
</html>
