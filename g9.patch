diff --git a/public/js/app-shell.js b/public/js/app-shell.js
index eac6410..870989b 100644
--- a/public/js/app-shell.js
+++ b/public/js/app-shell.js
@@ -191,14 +191,13 @@ function adjustMainLayout() {
   const mainLayout = document.getElementById('main-layout');
   if (!mainLayout) return;
   const isOpen = expanded && expanded.classList.contains('open');
-  // 44px rail + 240px expanded when open
-  const leftOffset = isOpen ? '284px' : '44px';
-  mainLayout.style.marginLeft = leftOffset;
-
-  // Sidebar width change alters the VP canvas dimensions — notify the viewport
-  // system to recompute renderer sizes and fire a fresh render frame so the
-  // canvas never shows a black strip after the sidebar slides in/out.
-  // A 200ms delay lets the CSS transition finish before we measure clientWidth.
+
+  // Use CSS variable --sidebar-w instead of hardcoded pixel.
+  // --sidebar-w: 0 when closed, 240px when open.
+  // --nav-w (44px) is always present as nav-rail width.
+  mainLayout.style.setProperty('--sidebar-w', isOpen ? '240px' : '0px');
+
+  // Notify viewport system to recompute renderer sizes after CSS transition.
   setTimeout(() => {
     if (typeof window._atlNotifyVPResize === 'function') window._atlNotifyVPResize();
   }, 220);
