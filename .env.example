# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...

# ─── Auth ────────────────────────────────────────────────────────────────────
SESSION_SECRET=<random 64-char hex — generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
ENCRYPTION_KEY=<random 32-byte hex — generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
MAGIC_LINK_SECRET=<random string>
ADMIN_SECRET=<random string used to grant admin role via POST /api/auth/grant-admin>

# ─── Email ───────────────────────────────────────────────────────────────────
POLSIA_EMAIL_PROXY_URL=https://...
EMAIL_FROM=Atlantist <noreply@atlantist.cloud>

# ─── Wallt AI ────────────────────────────────────────────────────────────────
WALLT_API_TOKEN=<from support@atlantist.cloud>
WALLT_MASTER_SECRET=<master secret — keep safe, used for HKDF key derivation>

# ─── OpenAI / AI proxy ───────────────────────────────────────────────────────
OPENAI_API_KEY=<OpenAI API key or Polsia AI proxy key>
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── GitHub OAuth (for contributor system) ───────────────────────────────────
GITHUB_CLIENT_ID=<from GitHub OAuth App settings>
GITHUB_CLIENT_SECRET=<from GitHub OAuth App settings>
GITHUB_WEBHOOK_SECRET=<random string, set in GitHub repo webhook settings>

# ─── Stripe (for subscriptions and contributor payouts) ──────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ─── Webhooks (DOB, fire protection, geotechnical) ───────────────────────────
# Callers must send HMAC-SHA256 of raw body in X-Webhook-Signature-256 header
WEBHOOK_SECRET=<random 32-char string>

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ─── Render ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
CANONICAL_ORIGIN=https://atlantist.cloud

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://...

# ─── Optional / future ───────────────────────────────────────────────────────
FORGE_CLIENT_ID=<Autodesk Platform Services — for RVT cloud processing>
FORGE_CLIENT_SECRET=<Autodesk Platform Services>
ADMIN_EMAIL=<email address for admin notifications>
SUPPORT_FORWARD_1=<email address to forward support tickets>
