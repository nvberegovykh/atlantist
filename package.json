{
  "name": "atlantist",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run migrate && npm run build:verify",
    "migrate": "node migrate.js",
    "guard": "node scripts/syntax-check.js",
    "build:syntax": "node scripts/syntax-check.js",
    "build:smoke": "node scripts/smoke-test.js",
    "build:verify": "npm run build:syntax && npm run build:smoke",
    "test": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "npx playwright test",
    "test:load": "k6 run tests/load/",
    "test:stress": "node tests/stress/sagrada-familia.js",
    "test:all": "jest --testPathPattern=tests/unit && jest --testPathPattern=tests/integration",
    "test:rvt": "node jobs/rvt-test-runner.js"
  },
  "dependencies": {
    "@sentry/node": "^8.0.0",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.6",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "redis": "^4.7.0",
    "resend": "^6.12.4",
    "stripe": "^16.0.0",
    "ws": "^8.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/",
      "/tests/load/",
      "/tests/stress/",
      "/tests/scripts/"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/unit/**/*.test.js",
      "**/tests/integration/**/*.test.js"
    ]
  }
}
